{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sshepherd/files-ls",
  "title": "sshepherd files ls",
  "description": "Directory listing (structured, byte sizes).",
  "x-sshepherd": {
    "group": "files",
    "action": "ls",
    "mutating": false,
    "exposes": "metadata",
    "timeout_sec": 25,
    "data_shape": "recorded",
    "args": [
      {
        "name": "path",
        "kind": "positional",
        "required": true
      }
    ]
  },
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "alias",
    "ran_at",
    "command",
    "duration_ms",
    "scrubbed",
    "data",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "Fields are only ever added within a version."
    },
    "ok": {
      "type": "boolean"
    },
    "alias": {
      "type": "string"
    },
    "ran_at": {
      "type": "string",
      "format": "date-time"
    },
    "command": {
      "const": "files ls"
    },
    "duration_ms": {
      "type": "integer"
    },
    "scrubbed": {
      "type": "integer",
      "description": "How many values the scrubber masked."
    },
    "data": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "group": {
                "type": "string"
              },
              "is_dir": {
                "type": "boolean"
              },
              "is_symlink": {
                "type": "boolean"
              },
              "link_target": {
                "type": "null"
              },
              "links": {
                "type": "integer"
              },
              "modified_at": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "permissions": {
                "type": "string"
              },
              "size_bytes": {
                "type": "integer"
              }
            }
          }
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "description": "Stable error code; see SshErrorCode in src/types.ts."
            },
            "message": {
              "type": "string"
            },
            "hint": {
              "type": "string",
              "description": "One sentence on what to do about this code."
            },
            "retryable": {
              "type": "boolean"
            },
            "next": {
              "type": "string",
              "description": "An exact, runnable command that moves the caller forward."
            },
            "did_you_mean": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "remote_exit": {
              "type": "integer"
            },
            "phase": {
              "enum": [
                "connect",
                "command"
              ]
            },
            "timeout_sec": {
              "type": "integer"
            },
            "budget_sec": {
              "type": "integer"
            },
            "elapsed_ms": {
              "type": "integer"
            },
            "op_outcome": {
              "enum": [
                "ok",
                "error",
                "refused"
              ]
            },
            "op_error": {
              "type": "object",
              "description": "AUDIT_WRITE_FAILED only: the op error, same shape."
            },
            "stderr_tail": {
              "type": "string",
              "description": "Last lines of the remote command stderr, scrubbed."
            },
            "data": {
              "type": "object",
              "description": "Structured detail an op recovered from the failure."
            }
          }
        }
      ]
    },
    "output_truncated": {
      "const": true,
      "description": "Present only when output was cut by a byte or item cap."
    },
    "fields_unmatched": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "--fields paths that matched nothing."
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "const": "AUDIT_UNWRITABLE"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "path_role": {
            "enum": [
              "state_dir",
              "audit_archive",
              "audit_file"
            ]
          },
          "errno": {
            "type": "string"
          }
        }
      },
      "description": "Present only when something beside the op failed; the op result still stands."
    }
  },
  "additionalProperties": true
}
