# Password-auth sshd for the onboarding checks (`setup host add`, `setup ssh-alias adopt-env`,
# `doctor hosts`): a host still on password login, the kind those commands move to a key.
#
# User `deploy` (no root login) with password authentication on. The image carries no usable
# password: the account stays locked until scripts/smoke.sh sets a fresh random one per run through
# `docker exec ... chpasswd` (stdin, never argv or env) and writes it to the 0600 state dir, where
# the tests read it to fill the install form or a fixture .env. No key material is baked in either;
# install appends the key it generates to deploy's authorized_keys at test time.

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-server \
    coreutils \
  && rm -rf /var/lib/apt/lists/*

# sshd_config.d is included at the top of Debian's sshd_config, so these win over its defaults.
RUN useradd -m -s /bin/sh deploy \
  && mkdir -p /run/sshd \
  && ssh-keygen -A \
  && { \
       echo 'PermitRootLogin no'; \
       echo 'PubkeyAuthentication yes'; \
       echo 'PasswordAuthentication yes'; \
       echo 'KbdInteractiveAuthentication no'; \
     } > /etc/ssh/sshd_config.d/10-fixture.conf

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D", "-e"]
