# Alpine sibling of Dockerfile.debian: ash login shell and BUSYBOX `timeout` (the part of the
# remote command wrapper GNU hosts never exercise), with GNU coreutils for everything else the
# ops assume (`ls --time-style` does not exist in busybox). coreutils would put its own
# /usr/bin/timeout ahead of busybox's on PATH, so that one path is pointed back at busybox. Same bind-mounted
# authorized_keys, same host docker socket, same key-only root login; not for production use.

FROM alpine:3.20

RUN apk add --no-cache openssh-server coreutils iproute2 procps-ng ca-certificates postgresql16-client \
  && ln -sf /bin/busybox /usr/bin/timeout \
  && ssh-keygen -A \
  && mkdir -p /root/.ssh \
  && chmod 700 /root/.ssh \
  && sed -i -e 's/^root:!:/root:*:/' /etc/shadow \
  && sed -i -e 's/^AllowTcpForwarding no/AllowTcpForwarding yes/' /etc/ssh/sshd_config \
  && { \
       echo 'PermitRootLogin prohibit-password'; \
       echo 'PubkeyAuthentication yes'; \
       echo 'PasswordAuthentication no'; \
     } >> /etc/ssh/sshd_config

COPY --from=docker:27-cli /usr/local/bin/docker /usr/local/bin/docker
# The compose plugin too: `services compose-ps`, `deploy status/logs/rollback` and the canary
# service (canary/docker-compose.yml) run `docker compose` from inside this container.
COPY --from=docker:27-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose

# Secret-shaped files for the masking checks in scripts/smoke.sh: env files and a plain script
# that exports a secret, a log to search, and a symlink out of the allowlisted /opt/myapp. Every value is an obviously fake fixture string.
RUN mkdir -p /opt/myapp \
  && printf 'DB_PASSWORD=fake-secret-value-1\nNODE_ENV=production\nexport API_KEY="fake-secret-value-1"\n' > /opt/myapp/prod.env \
  && printf '#!/bin/sh\nexport PORT=3000\nexport SESSION_SECRET=fake-secret-value-2\nexec /usr/local/bin/app\n' > /opt/myapp/start.sh \
  && printf 'APP_NAME=smoke\nDB_PASSWORD=fake-secret-value-3\nEMPTY_KEY=\nLOG_LEVEL=info\n' > /opt/myapp/.env \
  && printf '2026-11-27 INFO boot\n2026-11-27 ERROR upstream refused\n' > /opt/myapp/app.log \
  && ln -s /etc /opt/myapp/escape

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D", "-e"]
