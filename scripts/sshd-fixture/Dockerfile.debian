# Disposable local Linux target for `just smoke` (see scripts/smoke.sh).
#
# Provides sshd plus the same toolset sshepherd's read-only ops assume on a real remote
# (coreutils, procps, iproute2, util-linux) and the docker CLI. The docker CLI here is
# client-only — no daemon runs inside this container. scripts/sshd-fixture/docker-compose.yml
# mounts the HOST's docker socket into this container (Docker-outside-of-Docker), so
# `services`/`logs docker`/`db` ops exec into the sibling `postgres`/`app` fixture
# containers exactly like they would on a real deploy host running docker compose.
#
# Not for production use: root SSH login is enabled (key-only, no password auth) purely
# so the docker socket is always reachable without fiddling with host-specific docker
# group GIDs. authorized_keys is bind-mounted at runtime by docker-compose.yml —
# scripts/smoke.sh generates a fresh ephemeral keypair per run; no key material is baked
# into this image.

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-server \
    coreutils \
    procps \
    iproute2 \
    util-linux \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# docker CLI only (no daemon) — talks to the host daemon via the mounted socket.
COPY --from=docker:27-cli /usr/local/bin/docker /usr/local/bin/docker
# The compose plugin too: `services compose-ps`, `deploy status/logs/rollback` and the canary
# service (canary/docker-compose.yml) run `docker compose` from inside this container.
COPY --from=docker:27-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose

RUN mkdir -p /run/sshd /root/.ssh \
  && chmod 700 /root/.ssh \
  && ssh-keygen -A \
  && { \
       echo 'PermitRootLogin prohibit-password'; \
       echo 'PubkeyAuthentication yes'; \
       echo 'PasswordAuthentication no'; \
       echo 'ChallengeResponseAuthentication no'; \
     } >> /etc/ssh/sshd_config

# Secret-shaped files for the masking checks in scripts/smoke.sh: env files and a plain script
# that exports a secret, a log to search, and a symlink out of the allowlisted /opt/myapp. Every value is an obviously fake fixture string.
RUN mkdir -p /opt/myapp \
  && printf 'DB_PASSWORD=fake-secret-value-1\nNODE_ENV=production\nexport API_KEY="fake-secret-value-1"\n' > /opt/myapp/prod.env \
  && printf '#!/bin/sh\nexport PORT=3000\nexport SESSION_SECRET=fake-secret-value-2\nexec /usr/local/bin/app\n' > /opt/myapp/start.sh \
  && printf 'APP_NAME=smoke\nDB_PASSWORD=fake-secret-value-3\nEMPTY_KEY=\nLOG_LEVEL=info\n' > /opt/myapp/.env \
  && printf '2026-11-27 INFO boot\n2026-11-27 ERROR upstream refused\n' > /opt/myapp/app.log \
  && ln -s /etc /opt/myapp/escape

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D", "-e"]
